#include <iostream>
using namespace std;
void checkBitRightShift(int num, int b)
{
    if ( (num >> (b - 1)) & 1 )
        cout << "Yes, given bit is set";
    else
        cout << "No, given bit is not set";
}
int main()
{
    int num, b;
    cout << "Enter number: ";
    cin >> num;
    cout << "Enter bit position: ";
    cin >> b;
    checkBitRightShift(num, b);
    return 0;
}
