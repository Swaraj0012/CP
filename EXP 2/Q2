#include <iostream>
using namespace std;
int checkBit(int pattern, int arr[], int n) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        if ((arr[i] & pattern) == pattern) {
            count++;
        }
    }
    return count;
}
int maxAND(int arr[], int n) {
    int res = 0;

    for (int bit = 31; bit >= 0; bit--) {
        int temp = res | (1 << bit);

        int count = checkBit(temp, arr, n);
        if (count >= 2) {
            res = temp;
        }
    }
    return res;
}
int main() {
    int arr[] = {8, 12, 16};
    int n = sizeof(arr) / sizeof(arr[0]);

    cout << maxAND(arr, n);
    return 0;
}
