#include <iostream>
using namespace std;
void checkBitLeftShift(int num, int b)
{
    if (num & (1 << (b - 1)))
        cout << "Yes, it's a bit set";
    else
        cout << "No, it's not a bit set";
}
int main()
{
    int num, b;
    cout << "Enter number: ";
    cin >> num;
    cout << "Enter bit position: ";
    cin >> b;
    checkBitLeftShift(num, b);
    return 0;
}
